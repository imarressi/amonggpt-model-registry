{
  "name": "amonggpt-model-registry",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Daily-refreshed, versioned roster of OpenRouter models for AmongGPT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "refresh": "tsx src/refresh.ts",
    "refresh:offline": "tsx src/refresh.ts --catalog tests/fixtures/catalog.json --dry-run"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
